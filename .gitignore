.vscode
.claude
target
data/raw
data/

# Python build and cache artefacts. `analysis/` is a checked-in workspace member as of the
# monorepo change, so these need naming explicitly -- the blanket `analysis/` ignore that
# used to cover them is gone, and the first commit of the package brought eight .pyc files
# with it.
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Map files
*.nc

# GMT writes a gmt.conf into whatever directory it runs in the moment anything calls
# `gmtset`, which pygmt does on some paths. It records machine-local settings (data server,
# cache paths) and belongs to nobody's checkout.
gmt.conf

# MCAP test output files
*.mcap

# Ignore latex junk
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.bbl
*.blg
*.bcf
*.zip
*.nav
*.snm
*.toc
*.vrb
*.run.xml

# Leftover pixi environments. pixi.toml itself was removed in #335 -- the repository is
# plain cargo now -- but an existing .pixi/ directory should stay out of the index.
.pixi

# Data output
data/output/*

papers/anomaly_ukf/data/combined_statistics_error.csv

# mdBook output
book/book/

# Generated performance plots
data/output/*.png

# Research artifacts kept locally, out of the v1.0 release scope.
# See papers/README.md for where these live now. `analysis/` used to be on this list; it is a
# checked-in workspace member now, but these loose scripts and notebooks are not.
papers/anomaly_rbpf/
papers/anomaly_ukf/
papers/data_paper/
data.ipynb
analysis_rbpf_results.py
README_files/
log/

# Analysis notebooks, untracked in #335. They import pygmt, cartopy, numpy and filterpy
# against the Python environment pixi used to provide. `analysis/` is now a checked-in
# workspace member with its own dependency set, so a notebook worth keeping should move
# there rather than be un-ignored here. The map provenance they used to be the only record
# of now lives in geonav/README.md.
examples/geonav-sim/
examples/strapdown-sim/
